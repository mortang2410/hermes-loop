{
  "name": "@local/hermes-loop-i18n",
  "version": "0.1.16-i18n.1",
  "description": "dsh 插件 · hermes-loop 本地分支（上游 weibaohui/hermes-loop 0.1.16）：宿主侧 review prompt、长期记忆快照与收尾沉淀 section 改为跟随 DSH 语言设置（读 settings 文档 ns=locale 的 preference），其余行为与上游一致。",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "skills",
    "hermes",
    "learning-loop",
    "dsh-plugin",
    "i18n",
    "locale",
    "localization"
  ],
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/bundle.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "client",
    "cordis.patch.yml"
  ],
  "scripts": {
    "check": "node --check src/index.js && node --check client/bundle.js",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22.5",
    "dsh": ">=0.1.7-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weibaohui/hermes-loop.git (upstream; local fork in dsh-test/hermes-loop-i18n)"
  },
  "homepage": "https://github.com/weibaohui/hermes-loop#readme",
  "bugs": {
    "url": "https://github.com/weibaohui/hermes-loop/issues"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
